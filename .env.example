# Entorno ACADEMIX
DEBUG=True
SECRET_KEY=academix-super-secure-dev-key-change-in-production-2026!#sena

# Hosts permitidos: use '*' para permitir cualquier dispositivo en la red local (Wi-Fi / Ethernet)
ALLOWED_HOSTS=*

# Orígenes confiables para CSRF (requerido para formularios y login en red local en Django 4+)
# Separe por comas las URLs con su esquema y puerto (ej. http://192.168.1.50:8000)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de Datos MySQL (para uso en red con servidor de base de datos centralizado)
# DB_ENGINE=mysql
# DB_NAME=academix_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Modo Fallback con SQLite (concurrencia optimizada con modo WAL para red local)
USE_SQLITE_FALLBACK=True
